"""
Claustor AI — Hybrid Search
Combines Pinecone semantic search + PostgreSQL full-text search.
Uses Reciprocal Rank Fusion (RRF) to merge results.
"""

import asyncio
from uuid import UUID

import structlog
from sqlalchemy import text
from sqlalchemy.ext.asyncio import AsyncSession

from app.infrastructure.vector_store.pinecone_store import get_vector_store

logger = structlog.get_logger(__name__)

RRF_K = 60
SEMANTIC_WEIGHT = 0.6
KEYWORD_WEIGHT  = 0.7


class HybridSearchResult:
    def __init__(self, text, contract_id, chunk_index, clause_type,
                 page, semantic_score=0.0, keyword_score=0.0,
                 rrf_score=0.0, source="hybrid", chunk_id=None, id=None,
                 parent_id=None, heading=None, is_parent=False):
        self.text = text
        self.contract_id = contract_id
        self.chunk_index = chunk_index
        self.clause_type = clause_type
        self.page = page
        self.semantic_score = semantic_score
        self.keyword_score = keyword_score
        self.rrf_score = rrf_score
        self.source = source
        self.chunk_id = chunk_id or id or ""
        self.id = self.chunk_id
        self.parent_id = parent_id
        self.heading = heading
        self.is_parent = is_parent

    def to_dict(self):
        return {
            "text": self.text,
            "contract_id": self.contract_id,
            "chunk_index": self.chunk_index,
            "clause_type": self.clause_type,
            "page": self.page,
            "semantic_score": round(self.semantic_score, 4),
            "keyword_score": round(self.keyword_score, 4),
            "rrf_score": round(self.rrf_score, 4),
            "source": self.source,
        }


class HybridSearchEngine:

    def __init__(self):
        self.vector_store = get_vector_store()

    async def search(
        self,
        query: str,
        org_id: UUID,
        db: AsyncSession,
        contract_id: UUID | None = None,
        top_k: int = 6,
        semantic_top_k: int = 15,
        keyword_top_k: int = 15,
        clause_type: str | None = None,
    ) -> list[HybridSearchResult]:

        # Run both searches in parallel
        semantic_task = asyncio.create_task(
            self._semantic_search(query, org_id, contract_id, semantic_top_k, clause_type)
        )
        keyword_task = asyncio.create_task(
            self._keyword_search(query, org_id, db, contract_id, keyword_top_k, clause_type)
        )

        semantic_results, keyword_results = await asyncio.gather(
            semantic_task, keyword_task, return_exceptions=True
        )

        if isinstance(semantic_results, Exception):
            logger.warning("semantic_search_failed", error=str(semantic_results))
            semantic_results = []
        if isinstance(keyword_results, Exception):
            logger.warning("keyword_search_failed", error=str(keyword_results))
            keyword_results = []

        logger.info(
            "hybrid_search_raw",
            semantic_hits=len(semantic_results),
            keyword_hits=len(keyword_results),
        )

        # Debug semantic results before RRF
        if semantic_results and isinstance(semantic_results, list) and semantic_results:
            s = semantic_results[0]
            if isinstance(s, dict):
                print(f"DEBUG semantic[0] keys={list(s.keys())[:6]} chunk_id={s.get('chunk_id','MISSING')}")
            else:
                print(f"DEBUG semantic[0] type={type(s).__name__} chunk_id={getattr(s,'chunk_id','MISSING')}")
        fused = self._rrf(semantic_results, keyword_results, top_k)

        # ── Fetch full text from PostgreSQL ──
        # Pinecone only has text_preview (200 chars), get full text
        def _get(r, key, default=""):
            if isinstance(r, dict): return r.get(key, default)
            return getattr(r, key, default) or default
        all_chunk_ids = list({_get(r,"chunk_id") or _get(r,"id") for r in fused if _get(r,"chunk_id") or _get(r,"id")})
        print(f"DEBUG hybrid: fused count={len(fused)} types={set(type(r).__name__ for r in fused)}")
        if fused:
            sample = fused[0]
            if isinstance(sample, dict):
                print(f"DEBUG sample keys: {list(sample.keys())[:8]}")
            else:
                print(f"DEBUG sample attrs: {[a for a in dir(sample) if not a.startswith('_')][:8]}")
        # Debug chunk_id values
        for r in fused[:2]:
            cid = _get(r,"chunk_id")
            rid = _get(r,"id")
            print(f"DEBUG chunk_id={repr(cid)} id={repr(rid)}")
        print(f"DEBUG hybrid: all_chunk_ids={all_chunk_ids[:3] if all_chunk_ids else []} db={db is not None}")
        if all_chunk_ids and db:
            try:
                from app.infrastructure.vector_store.chunk_indexer import (
                    fetch_chunk_texts, fetch_parent_texts)
                chunk_texts = await fetch_chunk_texts(all_chunk_ids, db)

                # Enrich results with full text
                for r in fused:
                    cid = _get(r,"chunk_id") or _get(r,"id")
                    if cid and cid in chunk_texts:
                        if isinstance(r, dict):
                            r["text"] = chunk_texts[cid]["text"]
                            r["parent_id"] = chunk_texts[cid].get("parent_id")
                            r["heading"] = r.get("heading") or chunk_texts[cid].get("heading","")
                        else:
                            r.text = chunk_texts[cid]["text"]

                # ── Multi-level retrieval: fetch parent sections ──
                parent_ids = list({_get(r,"parent_id") for r in fused
                                   if _get(r,"parent_id") and not _get(r,"is_parent")})
                if parent_ids:
                    parent_texts = await fetch_parent_texts(parent_ids, db)
                    # Append parent context to results (not duplicating if already present)
                    existing_ids = {r.get("chunk_id") or r.get("id","") for r in fused}
                    for pid, pdata in parent_texts.items():
                        if pid not in existing_ids:
                            fused.append({
                                "id": pid,
                                "chunk_id": pid,
                                "text": pdata["text"],
                                "heading": pdata.get("heading",""),
                                "section_ref": pdata.get("section_ref",""),
                                "chunk_type": "clause",
                                "is_parent": True,
                                "vector_score": 0.0,
                                "bm25_score": 0.0,
                                "importance": "high",
                            })
            except Exception as _fe:
                logger.warning(f"chunk_text_fetch_error: {_fe}")

        # Convert to HybridSearchResult
        final = []
        for r in fused:
            if isinstance(r, HybridSearchResult):
                final.append(r)
            elif isinstance(r, dict) and r.get("text"):
                final.append(HybridSearchResult(
                    chunk_id=r.get("chunk_id") or r.get("id",""),
                    text=r.get("text",""),
                    contract_id=r.get("contract_id",""),
                    chunk_index=r.get("chunk_index",0),
                    clause_type=r.get("chunk_type","clause"),
                    page=r.get("page_number",0),
                    semantic_score=r.get("vector_score",0.0),
                    keyword_score=r.get("bm25_score",0.0),
                    rrf_score=r.get("vector_score",0.0),
                    source="hybrid",
                    parent_id=r.get("parent_id"),
                    heading=r.get("heading"),
                ))
        return final[:top_k + 3]  # allow slightly more for parent chunks

    async def _semantic_search(
        self,
        query: str,
        org_id: UUID,
        contract_id: UUID | None,
        top_k: int,
        clause_type: str | None,
    ) -> list[dict]:
        """Semantic search via Pinecone, fetch full text from PostgreSQL."""
        from app.infrastructure.vector_store.pinecone_store import get_vector_store
        vs = get_vector_store()
        namespace = f"org_{str(org_id).replace('-','')[:8]}"

        # Build filter
        filt = {"org_id": str(org_id)}
        if contract_id:
            filt["contract_id"] = str(contract_id)
        filt["chunk_type"] = {"$nin": ["signature"]}
        if clause_type:
            filt["chunk_type"] = clause_type

        embedder = await vs.get_embedder()
        import asyncio as _aio
        loop = _aio.get_event_loop()
        embedding = await loop.run_in_executor(
            None,
            lambda: embedder.encode([query], normalize_embeddings=True)[0].tolist()
        )

        try:
            idx = vs._get_index()
            res = await loop.run_in_executor(
                None,
                lambda: idx.query(
                    vector=embedding,
                    top_k=top_k,
                    namespace=namespace,
                    filter=filt,
                    include_metadata=True,
                )
            )
            matches = res.get("matches", []) if isinstance(res, dict) else res.matches
        except Exception as e:
            logger.warning(f"pinecone_search_error: {e}")
            return []

        if not matches:
            return []

        # Extract chunk_ids and fetch full text from PostgreSQL
        chunk_ids = []
        score_map = {}
        meta_map = {}
        for m in matches:
            mid = m["id"] if isinstance(m, dict) else m.id
            meta = m.get("metadata", {}) if isinstance(m, dict) else (m.metadata or {})
            score = m.get("score", 0) if isinstance(m, dict) else m.score
            chunk_id = meta.get("chunk_id", mid.replace("chunk_", ""))
            chunk_ids.append(chunk_id)
            score_map[chunk_id] = score
            meta_map[chunk_id] = meta

        logger.debug(f"vector_search: org_id={org_id} query={query!r} results={len(chunk_ids)} top_score={max(score_map.values(), default=0):.4f}")
        return [
            {
                "id":          cid,
                "text":        meta_map[cid].get("text_preview", ""),  # will be enriched
                "heading":     meta_map[cid].get("heading", ""),
                "section_ref": meta_map[cid].get("section_ref", ""),
                "chunk_type":  meta_map[cid].get("chunk_type", "clause"),
                "parent_id":   meta_map[cid].get("parent_id", ""),
                "importance":  meta_map[cid].get("importance", "low"),
                "risk_score":  meta_map[cid].get("risk_score", 0),
                "vector_score":score_map[cid],
                "chunk_id":    cid,
            }
            for cid in chunk_ids
        ]

    async def _keyword_search(
        self,
        query: str,
        org_id: UUID,
        db: AsyncSession,
        contract_id: UUID | None,
        top_k: int,
        clause_type: str | None,
    ) -> list[dict]:
        """BM25 search on contract_chunks table (GIN tsvector index)."""
        from app.infrastructure.vector_store.chunk_indexer import bm25_search
        results = await bm25_search(
            query=query,
            org_id=org_id,
            db=db,
            contract_id=contract_id,
            top_k=top_k,
            exclude_types=["signature"],
        )
        logger.info(f"bm25_search_results: count={len(results)} query={query[:30]!r}")
        return results

"""
Claustor AI — Hybrid Search
Combines Pinecone semantic search + PostgreSQL full-text search.
Uses Reciprocal Rank Fusion (RRF) to merge results.
"""

import asyncio
from uuid import UUID

import structlog
from sqlalchemy import text
from sqlalchemy.ext.asyncio import AsyncSession

from app.infrastructure.vector_store.pinecone_store import get_vector_store

logger = structlog.get_logger(__name__)

RRF_K = 60
SEMANTIC_WEIGHT = 0.6
KEYWORD_WEIGHT  = 0.7

_hybrid_engine: HybridSearchEngine | None = None

    def _rrf(self, semantic: list, keyword: list, top_k: int) -> list:
        """Reciprocal Rank Fusion to merge semantic and keyword results."""
        scores: dict = {}
        all_results: dict = {}

        for rank, r in enumerate(semantic):
            key = r.get("chunk_id") or r.get("id","") if isinstance(r,dict) else getattr(r,"chunk_id","") or getattr(r,"id","")
            if not key: key = f"sem_{rank}"
            scores[key] = scores.get(key, 0) + SEMANTIC_WEIGHT / (RRF_K + rank + 1)
            all_results[key] = r

        for rank, r in enumerate(keyword):
            key = r.get("chunk_id") or r.get("id","") if isinstance(r,dict) else getattr(r,"chunk_id","") or getattr(r,"id","")
            if not key: key = f"kw_{rank}"
            scores[key] = scores.get(key, 0) + KEYWORD_WEIGHT / (RRF_K + rank + 1)
            if key not in all_results:
                all_results[key] = r

        ranked = sorted(scores.items(), key=lambda x: x[1], reverse=True)[:top_k]
        fused = []
        for key, rrf in ranked:
            r = all_results[key]
            if isinstance(r, HybridSearchResult):
                r.rrf_score = rrf
                fused.append(r)
            elif isinstance(r, dict):
                source = "semantic" if key.startswith("sem_") or r.get("vector_score") else "keyword"
                fused.append(HybridSearchResult(
                    chunk_id=r.get("chunk_id") or r.get("id",""),
                    text=r.get("text",""),
                    contract_id=r.get("contract_id",""),
                    chunk_index=r.get("chunk_index",0),
                    clause_type=r.get("clause_type","") or r.get("chunk_type",""),
                    page=r.get("page",0) or r.get("page_number",0),
                    semantic_score=r.get("vector_score",0.0),
                    keyword_score=r.get("bm25_score",0.0),
                    rrf_score=rrf,
                    source=source,
                    parent_id=r.get("parent_id"),
                    heading=r.get("heading"),
                ))
        return fused


    def _rrf(self, semantic: list, keyword: list, top_k: int) -> list:
        """Reciprocal Rank Fusion to merge semantic and keyword results."""
        scores: dict = {}
        all_results: dict = {}
        for rank, r in enumerate(semantic):
            key = r.get("chunk_id") or r.get("id","") if isinstance(r,dict) else getattr(r,"chunk_id","") or getattr(r,"id","")
            if not key: key = f"sem_{rank}"
            scores[key] = scores.get(key, 0) + SEMANTIC_WEIGHT / (RRF_K + rank + 1)
            all_results[key] = r
        for rank, r in enumerate(keyword):
            key = r.get("chunk_id") or r.get("id","") if isinstance(r,dict) else getattr(r,"chunk_id","") or getattr(r,"id","")
            if not key: key = f"kw_{rank}"
            scores[key] = scores.get(key, 0) + KEYWORD_WEIGHT / (RRF_K + rank + 1)
            if key not in all_results:
                all_results[key] = r
        ranked = sorted(scores.items(), key=lambda x: x[1], reverse=True)[:top_k]
        fused = []
        for key, rrf in ranked:
            r = all_results[key]
            if isinstance(r, HybridSearchResult):
                r.rrf_score = rrf
                fused.append(r)
            elif isinstance(r, dict):
                fused.append(HybridSearchResult(
                    chunk_id=r.get("chunk_id") or r.get("id",""),
                    text=r.get("text",""),
                    contract_id=r.get("contract_id",""),
                    chunk_index=r.get("chunk_index",0),
                    clause_type=r.get("clause_type","") or r.get("chunk_type",""),
                    page=r.get("page",0) or r.get("page_number",0),
                    semantic_score=r.get("vector_score",0.0),
                    keyword_score=r.get("bm25_score",0.0),
                    rrf_score=rrf,
                    source="hybrid",
                    parent_id=r.get("parent_id"),
                    heading=r.get("heading"),
                ))
        return fused

def get_hybrid_search() -> HybridSearchEngine:
    global _hybrid_engine
    if _hybrid_engine is None:
        _hybrid_engine = HybridSearchEngine()
    return _hybrid_engine
